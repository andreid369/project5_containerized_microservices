# Local development settings (docker compose sets these for you).
# On AWS these come from the ECS task definition; the password comes from
# Secrets Manager via DB_SECRET_ARN, never from a file.
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=products
DB_USER=postgres
DB_PASSWORD=change-me-locally
DB_SSL=false
RUN_MIGRATIONS=true
LOG_LEVEL=info
